OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

PRODUCTS_JSON_PATH=data/products.json
PRODUCT_FEED_PATH=https://www.foodland.sk/ed3d2c21991e3bef5e069713af9fa6ca/googleMerchant_sk_export.xml
KNOWLEDGE_JSON_PATH=data/knowledge.json
FEED_REFRESH_MINUTES=180

ALLOWED_ORIGINS=https://www.foodland.sk,https://foodland.sk
RATE_LIMIT_PER_MINUTE=12

# --- Persistence (V2.12.1 Part A - see docs/durable-learning-storage.md) --
# FOODLAND_DATA_DIR is the ONE knob that repoints every runtime-written
# path below at a mounted Railway volume (Dashboard: Cmd+K -> "New Volume"
# -> attach to this service -> set a mount path, e.g. /data - dashboard/
# CLI only, Railway does not support declaring a volume from railway.json).
# Set it to that mount path (e.g. /data/foodland-ai-agent) and every
# ANALYTICS_LOG_PATH/ERROR_LOG_PATH/TAXONOMY_SHADOW_LOG_PATH/EVENTS_LOG_PATH/
# USER_MEMORY_PATH/PRODUCT_EMBEDDINGS_PATH/RANKING_PROFILE_DIR/
# LEARNING_HISTORY_DIR below that is left unset (empty) inherits it
# automatically - no more "missing one variable silently resets just that
# one piece of state" foot-gun. Any variable given an explicit value here
# still overrides FOODLAND_DATA_DIR for that one path specifically.
# Verify what's actually durable via GET /health -> "durable_storage".
FOODLAND_DATA_DIR=
ANALYTICS_LOG_PATH=
ERROR_LOG_PATH=
TAXONOMY_SHADOW_LOG_PATH=
EVENTS_LOG_PATH=/data/foodland-ai-agent/events.jsonl
ANALYTICS_INCLUDE_IP=false
ANALYTICS_SALT=replace-with-random-secret
USER_MEMORY_ENABLED=true
USER_MEMORY_PATH=
USER_MEMORY_MAX_PROFILES=50000

# Ranking profile (V2.11) and learning-engine audit trail (V2.12). Both
# default to a repo-relative "config/" directory if FOODLAND_DATA_DIR is
# ALSO unset - config/ranking_profiles is checked into git
# (config/ranking_profiles/v1.json is the built-in default profile), so on
# Railway specifically this directory resets to whatever is committed on
# EVERY redeploy, silently discarding any ranking profile promoted since
# (docs/durable-learning-storage.md). Leave these two empty once
# FOODLAND_DATA_DIR is set - they will follow it automatically. Falls back
# cleanly to last_known_good, then the built-in default profile, if
# nothing usable is found (app/ranking_config.py:get_active_ranking_profile(),
# GET /health -> durable_storage.active_ranking_profile_degraded).
RANKING_PROFILE_DIR=
LEARNING_HISTORY_DIR=

# --- Admin authorization (V2.12.1 Part B - see docs/admin-security.md) ----
# Three scopes, READ < OPERATIONS < PROMOTION (higher satisfies lower).
# ADMIN_ANALYTICS_TOKEN/ADMIN_RELOAD_TOKEN are legacy names kept for
# backward compatibility - they map to READ/OPERATIONS respectively and
# NEVER grant PROMOTION. Provision ADMIN_PROMOTION_TOKEN explicitly, and
# only to whoever should be able to approve/rollback a live ranking
# profile via POST /admin/learning/candidates/{id}/approve or
# POST /admin/learning/rollback.
ADMIN_READ_TOKEN=
ADMIN_OPERATIONS_TOKEN=
ADMIN_PROMOTION_TOKEN=
ADMIN_ANALYTICS_TOKEN=
ADMIN_RELOAD_TOKEN=
LOG_LEVEL=INFO

# V2.12 Controlled Auto-Learning & Self-Improvement Engine
# EVENTS_LOG_PATH (frontend click/add_to_cart/impression telemetry via
# POST /events) pre-dates V2.12 but is the primary input this engine
# reads - see the Persistence section above for why it must be repointed
# at a mounted volume on Railway (docs/learning-engine.md).
LEARNING_ENGINE_ENABLED=true
LEARNING_CANDIDATE_GENERATION_ENABLED=true
LEARNING_SHADOW_ENABLED=true
LEARNING_AUTO_PROMOTION_ENABLED=false
LEARNING_CYCLE_MINUTES=0
LEARNING_LOOKBACK_DAYS=30
