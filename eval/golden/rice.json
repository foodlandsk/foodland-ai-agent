{
  "dataset_version": "1.0",
  "domain": "rice",
  "note": "Every query below uses a real app.taxonomy.FAMILY_DEFINITIONS title_phrase or a natural customer variant of one - never invented text. must_not_concept_ids encode the exact rice-family collisions Section 33/116 call out by name (rice != rice noodles/vinegar/paper/cooker/flour).",
  "cases": [
    {
