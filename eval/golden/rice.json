      "expected_concept_ids": ["sushi_rice"],
      "must_not_concept_ids": ["jasmine_rice", "basmati_rice"],
      "note": "Natural use-case phrasing, not the bare taxonomy phrase."
    },
    {
      "id": "rice_glutinous_001",
      "query": "lepkava ryza",
      "query_type": "ATTRIBUTE",
      "expected_concept_ids": ["glutinous_rice"],
