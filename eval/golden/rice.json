      "must_not_concept_ids": ["rice_noodles", "rice_vinegar", "rice_paper", "rice_cooker"],
      "critical": true,
      "note": "Bare family mention (Section 25/26 of V2.4 spec - specificity monotonicity) must browse rice varieties, never rice-adjacent non-rice products."
    },
    {
