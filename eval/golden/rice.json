      "query_type": "ATTRIBUTE",
      "expected_concept_ids": ["jasmine_rice"],
      "must_not_concept_ids": ["rice_noodles", "rice_vinegar", "rice_paper", "rice_cooker", "rice_flour", "basmati_rice", "sushi_rice"],
      "expected_intent": "product_search",
      "critical": true,
      "note": "Core V2.4 mandated scenario - jasmine rice must never surface rice vinegar/noodles/paper/cooker."
    },
    {
      "id": "rice_jasmine_002",
      "query": "jazminova ryza 5kg",
      "query_type": "PACKAGE_SIZE",
      "expected_concept_ids": ["jasmine_rice"],
      "must_not_concept_ids": ["rice_noodles", "rice_vinegar", "rice_paper"],
      "note": "Package-size attribute must not change family eligibility."
    },
    {
      "id": "rice_basmati_001",
      "query": "basmati ryza",
      "query_type": "ATTRIBUTE",
      "expected_concept_ids": ["basmati_rice"],
      "must_not_concept_ids": ["jasmine_rice", "sushi_rice", "rice_noodles", "rice_vinegar"],
      "critical": true,
      "note": "Section 12 - basmati must not return jasmine rice merely because both are rice."
    },
    {
      "id": "rice_sushi_001",
      "query": "susi ryza",
      "query_type": "ATTRIBUTE",
      "expected_concept_ids": ["sushi_rice"],
